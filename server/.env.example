# Server Configuration
PORT=5001
NODE_ENV=development

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq API Key (If your Gemini free tier content generation has rate limits/quota: 0)
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI API Key (fallback generation + embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase / Neon / PostgreSQL Database URL Connection String
# Get this from: Supabase Dashboard > Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres.<project-ref>:your-password@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# PostgreSQL SSL settings
# Default: sslmode=require + rejectUnauthorized=true (secure for Supabase/Neon).
# Set PGSSL_REJECT_UNAUTHORIZED=false only for local dev with self-signed certs.
# Set PGSSLMODE=disable to disable SSL entirely (not recommended).
PGSSLMODE=require
PGSSL_REJECT_UNAUTHORIZED=true

# Supabase Auth (backend JWT verification + CORS allowlist)
# Get these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Comma-separated list of allowed frontend origins (CORS + Socket.io)
# Example: FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Upstash Redis (Serverless In-Memory Room & Leaderboard Store)
# Get these from: https://console.upstash.com > Create Database > REST API
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# SMTP Configuration for Contact Us Form Actual Email Sending (e.g. Gmail)
SMTP_USER=your-smtp-user@example.com
# Destination inbox for contact messages
SMTP_TO=your-inbox@example.com
# For Gmail, generate an App Password in your Google Account Security Settings
SMTP_PASS=your_gmail_app_password_here
